{
  "name": "dsh-shell-dcg",
  "version": "0.1.0",
  "type": "module",
  "description": "Runs Destructive Command Guard (dcg) on every shell command a DeepSeek Harness tool is about to run.",
  "license": "MIT",
  "icon": "icon.svg",
  "author": "joonokon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joonokon/dsh-shell-dcg.git"
  },
  "bugs": {
    "url": "https://github.com/joonokon/dsh-shell-dcg/issues"
  },
  "homepage": "https://github.com/joonokon/dsh-shell-dcg#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dcg",
    "destructive-command-guard",
    "shell",
    "safety"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/*.md",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "test": "node test/all.mjs",
    "test:live": "node test/live.mjs",
    "probe": "node test/probe-dcg.mjs",
    "bench": "node test/bench.mjs",
    "compare": "node test/compare-versions.mjs",
    "install-dcg": "node tools/install-dcg.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}

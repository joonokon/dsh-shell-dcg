{
  "limits": {
    "enabledHits": 3
  },
  "extraPacks": [
    "heredoc.powershell"
  ],
  "shadowed": {
    "cicd.github_actions": "platform.github:gh-secret-delete answers first for every gh secret/variable delete form",
    "dns.route53": "cloud.aws:route53-delete-hosted-zone answers first for every delete-hosted-zone form",
    "remote.ssh": "core.filesystem:rm-rf-root-home answers first for every ssh \"rm -rf …\" form",
    "careful_company_running_windows.transfer": "remote.scp:scp-destination-unverified answers first for every scp form"
  },
  "waivers": {
    "loadbalancer.haproxy": "only the config-file rule is reachable; the socat control family needs a socket form this corpus does not synthesize yet",
